<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Двойник проекта BookClub.Tests для проверки тестов мутациями (Stryker).

    Stryker портит код сайта и смотрит, заметят ли это тесты. Для этого сайт и тесты должны жить в одном
    процессе. Основные тесты (BookClub.Tests) запускают сайт отдельно и ходят в него по сети, поэтому для
    Stryker они не подходят. Здесь те же самые файлы тестов подключены ссылками, а сайт поднимается внутри
    теста (см. Support/Api.cs). Код сайта и основные тесты не меняются.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>BookClub.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BookClub.csproj" />
  </ItemGroup>

  <!-- Те же тесты и помощники, что в BookClub.Tests. Браузерные (E2E) сюда не входят. Api.cs свой. -->
  <ItemGroup>
    <Compile Include="..\BookClub.Tests\Api\**\*.cs" Link="Api\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\BookClub.Tests\Support\**\*.cs" Exclude="..\BookClub.Tests\Support\Api.cs" Link="Support\Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="BookClub.Tests.Support" />
  </ItemGroup>

</Project>
