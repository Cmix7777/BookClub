{
  "stryker-config": {
    "project": "BookClub.csproj",
    "mutate": [
      "**/Controllers/*.cs",
      "**/Services/*.cs",
      "**/Extensions/*.cs"
    ],
    "reporters": [
      "dots",
      "cleartext",
      "json",
      "html"
    ],
    "coverage-analysis": "perTest",
    "concurrency": 1,
    "thresholds": {
      "high": 90,
      "low": 70,
      "break": 0
    },
    "ignore-methods": [
      "NotFound",
      "Conflict",
      "BadRequest",
      "Unauthorized",
      "Ok",
      "StatusCode"
    ]
  }
}
