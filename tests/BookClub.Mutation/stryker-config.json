{
  "stryker-config": {
    "project": "BookClub.csproj",
    "mutate": [
      "**/Controllers/*.cs",
      "**/Services/*.cs",
      "**/Extensions/*.cs",
      "**/Program.cs"
    ],
    "reporters": ["dots", "cleartext", "json", "html"],
    "coverage-analysis": "perTest",
    "concurrency": 2,
    "thresholds": {
      "high": 90,
      "low": 70,
      "break": 0
    }
  }
}
